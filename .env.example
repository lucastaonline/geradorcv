# E-mail que receberá os envios do formulário (CV + descrição da vaga)
RECIPIENT_EMAIL=seu-email@exemplo.com

# Credenciais SMTP (Gmail, Outlook, etc.)
# Para Gmail com 2FA: use "Senha de app" em vez da senha da conta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-ou-app-password

# Google Analytics 4 (opcional) — visitas e eventos (click_buy_credits, begin_checkout, purchase)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Log em arquivo de “checkout iniciado” (opcional; em serverless prefira logs com [analytics] no stdout)
# CHECKOUT_LOG_PATH=./logs/checkout.log
